{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": ["searchApi", "fileApi", "webGui", "doclingWorker", "persistence", "config"],
  "properties": {
    "maintenance": {"type": "object"},
    "searchApi": {"type": "object"},
    "ingestionWorker": {"type": "object"},
    "scanner": {"type": "object"},
    "mcp": {"type": "object"},
    "fileApi": {"type": "object"},
    "webGui": {"type": "object"},
    "doclingWorker": {"type": "object"},
    "persistence": {"type": "object"},
    "config": {
      "type": "object",
      "properties": {
        "docling": {
          "type": "object",
          "properties": {
            "device": {"enum": ["cpu"]},
            "allowModelDownloads": {"type": "boolean"},
            "ocrEnabled": {"type": "boolean"}
          }
        },
        "embedding": {
          "type": "object",
          "properties": {"dimensions": {"const": 768}}
        }
      }
    }
  }
}
