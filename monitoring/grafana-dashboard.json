{
  "title": "RAG Store",
  "uid": "rag-store",
  "timezone": "utc",
  "schemaVersion": 39,
  "panels": [
    {"type": "stat", "title": "Database up", "targets": [{"expr": "max(rag_store_database_up)"}], "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}},
    {"type": "stat", "title": "Docling models ready", "targets": [{"expr": "min(rag_store_docling_model_ready)"}], "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}},
    {"type": "stat", "title": "Scanner leaders", "targets": [{"expr": "sum(rag_store_scanner_leader)"}], "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}},
    {"type": "timeseries", "title": "Search rate", "targets": [{"expr": "sum by (mode, outcome) (rate(rag_store_search_requests_total[5m]))"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}},
    {"type": "timeseries", "title": "Search latency", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, mode) (rate(rag_store_search_duration_seconds_bucket[5m])))"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}},
    {"type": "timeseries", "title": "Jobs by state", "targets": [{"expr": "max by (state) (rag_store_jobs_pending)"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}},
    {"type": "timeseries", "title": "Conversions", "targets": [{"expr": "sum by (route, outcome) (rate(rag_store_conversions_total[5m]))"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}},
    {"type": "timeseries", "title": "Embedding failures", "targets": [{"expr": "sum(rate(rag_store_embedding_failures_total[5m]))"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}},
    {"type": "timeseries", "title": "Free document storage", "targets": [{"expr": "min by (scope) (rag_store_storage_free_bytes)"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}}
  ]
}
